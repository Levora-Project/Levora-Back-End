    {
      "name": "Document Management",
      "item": [
        {
          "name": "POST /profile/documents (upload PDF)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response time < 1s', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});",
                  "pm.test('Extract document id', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('document_id', jsonData.data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "docType",
                  "value": "resume",
                  "type": "text"
                },
                {
                  "key": "file",
                  "value": "dummy pdf content",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/profile/documents",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "profile", "documents"]
            }
          }
        },
