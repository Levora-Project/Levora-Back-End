        {
          "name": "GET /auth/me - Without JWT (401 Unauthorized)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Clear cookies from the cookie jar to simulate an unauthenticated request.",
                  "// Newman's cookie jar persists cookies across requests by default, which can cause false positives.",
                  "// Always use explicit Authorization headers for authenticated requests rather than relying on cookies.",
                  "pm.cookies.clear();",
                  "pm.request.headers.remove('Cookie');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
