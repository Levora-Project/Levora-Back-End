# ──────────────────────────────────────────────
# Environment Variables – Backend
# ──────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3000
APP_NAME=my-app
API_PREFIX=api

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_hub?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=5000

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:4200
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
JWT_SECRET=dev-only-secret-do-not-use-in-production!!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Logging
LOG_DIR=./logs
LOG_MAX_SIZE=10m
LOG_FREQUENCY=daily
LOG_MAX_FILES=30

